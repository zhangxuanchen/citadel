# Copy this file to deploy/online.env before production release.
# Only put non-secret online parameters here.
# MySQL passwords and RSA JWT keys are generated automatically by deploy.sh.

HTTP_PORT=80
PUBLIC_BASE_URL=https://auth.example.com
TZ=UTC

JWT_ISSUER=citadel
JWT_KEY_ID=authz-prod-key-1
JWT_EXPIRATION=2h
JWT_REFRESH_EXPIRATION=7d

AUTHZ_RATE_LIMIT_ENABLED=true
AUTHZ_RATE_LIMIT_MAX_REQUESTS=120
AUTHZ_RATE_LIMIT_WINDOW=1m

AUTHZ_LOGIN_PROTECTION_ENABLED=true
AUTHZ_LOGIN_MAX_FAILURES=5
AUTHZ_LOGIN_LOCK_DURATION=15m
